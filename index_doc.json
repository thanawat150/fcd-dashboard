{"text": "<meta name=\"dash-one-writer\">\n<style>\n#dash-root .fcd { display: flex; flex-direction: column; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans);\n  --lv-high: #3f9a4a; --lv-mid: #dfae1c; --lv-low: #d6452f; --lv-none: #9b9b9b; }\n.fcd b { font-weight: var(--cds-font-weight-medium); }\n.fcd-head { display: flex; flex-direction: column; gap: var(--cds-gap-sm); }\n.fcd-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n.fcd-take { margin: 0; max-width: 70ch; color: var(--color-fg); line-height: 1.6; }\n.fcd-sub { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.fcd-bar { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm) var(--cds-gap-md); align-items: center; }\n.fcd-bar label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.fcd-scope { min-width: 0; max-width: 100%; }\n.fcd-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); gap: var(--cds-gap-md); }\n.fcd-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-md) var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-xs); min-width: 0; }\n.fcd-tile-k { display: flex; align-items: center; gap: var(--cds-gap-xs); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.fcd-tile-v { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; line-height: 1.15; }\n.fcd-tile-v small { font-family: var(--font-anthropic-sans); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-left: .25em; }\n.fcd-tile-p { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.sw { display: inline-block; width: .7rem; height: .7rem; border-radius: 2px; flex: none; }\n.sw-high { background: var(--lv-high); } .sw-mid { background: var(--lv-mid); } .sw-low { background: var(--lv-low); } .sw-none { background: var(--lv-none); }\n.fcd-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: var(--cds-gap-md); }\n.fcd-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-md); min-width: 0; }\n.fcd-card h2 { margin: 0; font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); }\n.fcd-card-head { display: flex; flex-direction: column; gap: var(--cds-gap-xs); }\n.fcd-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.fcd-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n.fcd-seg { display: inline-flex; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); overflow: hidden; }\n.fcd-seg button { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); background: transparent; color: var(--color-fg-muted); border: 0; cursor: pointer; }\n.fcd-seg button + button { border-left: 1px solid var(--color-border-line); }\n.fcd-seg button[aria-pressed=\"true\"] { background: var(--color-bg); color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.fcd-seg button:focus-visible, .fcd th button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: -2px; }\n.fcd-chart { position: relative; min-height: 6rem; display: flex; flex-direction: column; gap: 2px; }\n.fcd-scroll { max-height: 40rem; overflow: auto; padding-right: 2px; }\n.hrow { display: grid; grid-template-columns: minmax(4.5rem, 8rem) minmax(0, 1fr) 6rem; gap: var(--cds-gap-sm); align-items: center; font-size: var(--cds-font-size-body); min-height: 32px; padding: 0 2px; }\n.hrow .lb { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.hrow .vl { text-align: right; font-variant-numeric: tabular-nums; color: var(--color-fg-muted); }\n.hrow .tr { height: 20px; display: flex; border-radius: 3px; overflow: hidden; background: transparent; }\n.hrow .tr i { display: block; height: 100%; }\n.hrow:hover .lb { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.hrow:hover .tr { outline: 1px solid var(--color-fg-muted); }\n.seg-high { background: var(--lv-high); } .seg-mid { background: var(--lv-mid); } .seg-low { background: var(--lv-low); } .seg-none { background: var(--lv-none); }\n.fcd-tip { position: absolute; z-index: 5; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); min-width: 11rem; }\n.fcd-tip .tt { color: var(--cds-text-secondary); margin-bottom: 2px; }\n.fcd-tip .tl { display: flex; align-items: center; gap: var(--cds-gap-xs); font-variant-numeric: tabular-nums; }\n.fcd-tip .tl em { font-style: normal; margin-left: auto; padding-left: var(--cds-pad-sm); }\n.fcd-rank { margin: 0; padding-left: 1.4rem; display: flex; flex-direction: column; gap: var(--cds-gap-xs); font-variant-numeric: tabular-nums; }\n.fcd-rank li span { color: var(--color-fg-muted); }\n.fcd-tools { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm) var(--cds-gap-md); align-items: center; }\n.fcd-search { font: inherit; font-size: var(--cds-font-size-caption); padding: var(--cds-pad-xs) var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-bg); color: var(--color-fg); min-width: 0; width: 16rem; max-width: 100%; }\n.fcd-tbox { max-height: 34rem; overflow: auto; }\n.fcd table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.fcd th { position: sticky; top: 0; background: var(--color-panel); text-align: left; border-bottom: 1px solid var(--color-border-line); padding: 0; z-index: 1; }\n.fcd th .th-t { display: block; padding: var(--cds-pad-xs) var(--cds-pad-sm); font-weight: var(--cds-font-weight-medium); white-space: nowrap; }\n.fcd th button { font: inherit; font-weight: var(--cds-font-weight-medium); color: var(--color-fg); background: none; border: 0; padding: var(--cds-pad-xs) var(--cds-pad-sm); cursor: pointer; width: 100%; text-align: inherit; white-space: nowrap; }\n.fcd th[aria-sort=\"ascending\"] button::after { content: \" ▲\"; color: var(--color-fg-muted); }\n.fcd th[aria-sort=\"descending\"] button::after { content: \" ▼\"; color: var(--color-fg-muted); }\n.fcd td { padding: var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.fcd .n { text-align: right; }\n.fcd td.wrap { white-space: normal; min-width: 12rem; color: var(--color-fg-muted); }\n.fcd details { border-top: 1px solid var(--color-border-line); padding-top: var(--cds-pad-md); }\n.fcd summary { cursor: pointer; font-weight: var(--cds-font-weight-medium); }\n.fcd dl { display: grid; grid-template-columns: minmax(7rem, max-content) minmax(0, 1fr); gap: var(--cds-gap-xs) var(--cds-gap-md); margin: var(--cds-gap-md) 0 0; max-width: 80ch; }\n.fcd dt { font-weight: var(--cds-font-weight-medium); } .fcd dd { margin: 0; color: var(--color-fg-muted); }\n.fcd-comp { display: flex; height: 28px; border-radius: var(--cds-radius); overflow: hidden; max-width: 56rem; }\n.fcd-comp i { display: flex; align-items: center; justify-content: center; min-width: 0; font-style: normal; font-size: var(--cds-font-size-caption); font-weight: var(--cds-font-weight-medium); font-variant-numeric: tabular-nums; color: #fff; white-space: nowrap; overflow: hidden; }\n.fcd-comp i.seg-mid { color: #3a2c00; }\n.fcd-meter { height: 6px; border-radius: 3px; background: var(--color-border-line); overflow: hidden; }\n.fcd-meter i { display: block; height: 100%; width: 0; border-radius: 3px; }\n@media (prefers-reduced-motion: no-preference) { .fcd-meter i { transition: width var(--cds-dur-slow) var(--cds-ease-out); } }\n.fcd-reset { font: inherit; font-size: var(--cds-font-size-caption); min-height: 32px; padding: 0 var(--cds-pad-sm); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: var(--color-panel); color: var(--color-fg); cursor: pointer; }\n.fcd-reset:hover { border-color: var(--color-fg-muted); }\n.fcd-reset::after { content: \" ×\"; color: var(--color-fg-muted); }\n.hrow[role=\"button\"] { cursor: pointer; border-radius: var(--cds-radius); }\n.hrow[role=\"button\"]:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n.hrow[role=\"button\"]:focus-visible .lb { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.fcd-reset:focus-visible, .fcd tbody tr:focus-visible, .fcd-map a:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; }\n.fcd tbody tr:hover td { background: var(--color-bg); }\n.fcd-map img.loading { opacity: .4; }\n@media (prefers-reduced-motion: no-preference) { .fcd-map img { transition: opacity var(--cds-dur-slow) var(--cds-ease-out); } }\n.fcd-pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); gap: var(--cds-gap-md); align-items: start; }\n.fcd-map { position: relative; min-height: 20rem; display: flex; flex-direction: column; gap: var(--cds-gap-sm); }\n.fcd-map img { display: block; width: 100%; max-width: 100%; height: auto; aspect-ratio: 1240 / 1754; object-fit: contain; border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); background: #fff; }\n.fcd-map a { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.fcd-mapinfo { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.fcd-pick { max-width: 100%; }\n.hrow.pick { cursor: pointer; }\n.hrow.on .lb { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n.hrow.on .tr { outline: 2px solid var(--color-fg); }\n.fcd tbody tr { cursor: pointer; }\n.fcd tbody tr.on td { background: var(--color-bg); font-weight: var(--cds-font-weight-medium); }\n@media (max-width: 30rem) { .hrow { grid-template-columns: 4.5rem minmax(0, 1fr) 4.5rem; } .fcd .hide-sm { display: none; } }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"fcd\">\n  <header class=\"fcd-head\">\n    <h1 class=\"fcd-title\">สรุปเนื้อที่ FCD</h1>\n    <p class=\"fcd-take\"><b data-draw=\"scopeName\">—</b> มีเนื้อที่ FCD รวม <b data-draw=\"sum\" data-source=\"summary\" data-field=\"total\" data-where=\"scope=all\" data-fmt=\"rai\">—</b> ไร่ จาก <b data-draw=\"sum\" data-source=\"summary\" data-field=\"plots\" data-where=\"scope=all\" data-fmt=\"int\">—</b> แปลง เป็นระดับมาก <b data-draw=\"sum\" data-source=\"summary\" data-field=\"high_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</b> ปานกลาง <b data-draw=\"sum\" data-source=\"summary\" data-field=\"mid_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</b> น้อย <b data-draw=\"sum\" data-source=\"summary\" data-field=\"low_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</b> และไม่ระบุระดับ <b data-draw=\"sum\" data-source=\"summary\" data-field=\"none_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</b></p>\n    <div class=\"fcd-comp\" data-draw=\"comp\" data-source=\"summary\" role=\"img\" aria-label=\"สัดส่วนเนื้อที่แต่ละระดับ\">—</div>\n    <p class=\"fcd-sub\">เนื้อที่จากรูป FCD ที่ตัดตามขอบเขต \"ใช้งาน\" (1 ไร่ = 1,600 ม²) ไม่รวมแหล่งน้ำ</p>\n  </header>\n\n  <div class=\"fcd-bar\">\n    <label for=\"fcd-scope\">ดูข้อมูล</label>\n    <select id=\"fcd-scope\" class=\"dash-select fcd-scope\" data-draw=\"scope\" data-source=\"summary\" aria-label=\"เลือกขอบเขตข้อมูล\"></select>\n    <button type=\"button\" class=\"fcd-reset\" hidden>ดูทุกแปลง</button>\n    <span class=\"fcd-sub\">หรือกดชื่อจังหวัดในกราฟรายจังหวัด</span>\n  </div>\n\n  <section class=\"fcd-tiles\" aria-label=\"เนื้อที่แต่ละระดับ\">\n    <div class=\"fcd-tile\">\n      <div class=\"fcd-tile-k\">เนื้อที่ FCD รวม</div>\n      <div class=\"fcd-tile-v\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"total\" data-where=\"scope=all\" data-fmt=\"rai\">—</span><small>ไร่</small></div>\n      <div class=\"fcd-tile-p\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"plots\" data-where=\"scope=all\" data-fmt=\"int\">—</span> แปลง</div>\n    </div>\n    <div class=\"fcd-tile lv-high\">\n      <div class=\"fcd-tile-k\"><i class=\"sw sw-high\"></i>มาก (&gt;65%)</div>\n      <div class=\"fcd-tile-v\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"high\" data-where=\"scope=all\" data-fmt=\"rai\">—</span><small>ไร่</small></div>\n      <div class=\"fcd-tile-p\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"high_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</span> ของเนื้อที่</div>\n      <div class=\"fcd-meter\"><i class=\"seg-high\" data-draw=\"meter\" data-source=\"summary\" data-k=\"high_pct\"></i></div>\n    </div>\n    <div class=\"fcd-tile\">\n      <div class=\"fcd-tile-k\"><i class=\"sw sw-mid\"></i>ปานกลาง (30–65%)</div>\n      <div class=\"fcd-tile-v\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"mid\" data-where=\"scope=all\" data-fmt=\"rai\">—</span><small>ไร่</small></div>\n      <div class=\"fcd-tile-p\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"mid_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</span> ของเนื้อที่</div>\n      <div class=\"fcd-meter\"><i class=\"seg-mid\" data-draw=\"meter\" data-source=\"summary\" data-k=\"mid_pct\"></i></div>\n    </div>\n    <div class=\"fcd-tile\">\n      <div class=\"fcd-tile-k\"><i class=\"sw sw-low\"></i>น้อย (&lt;30%)</div>\n      <div class=\"fcd-tile-v\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"low\" data-where=\"scope=all\" data-fmt=\"rai\">—</span><small>ไร่</small></div>\n      <div class=\"fcd-tile-p\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"low_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</span> ของเนื้อที่</div>\n      <div class=\"fcd-meter\"><i class=\"seg-low\" data-draw=\"meter\" data-source=\"summary\" data-k=\"low_pct\"></i></div>\n    </div>\n    <div class=\"fcd-tile\">\n      <div class=\"fcd-tile-k\"><i class=\"sw sw-none\"></i>ไม่ระบุระดับ</div>\n      <div class=\"fcd-tile-v\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"none\" data-where=\"scope=all\" data-fmt=\"rai\">—</span><small>ไร่</small></div>\n      <div class=\"fcd-tile-p\"><span data-draw=\"sum\" data-source=\"summary\" data-field=\"none_pct\" data-where=\"scope=all\" data-fmt=\"pct\">—</span> ของเนื้อที่</div>\n      <div class=\"fcd-meter\"><i class=\"seg-none\" data-draw=\"meter\" data-source=\"summary\" data-k=\"none_pct\"></i></div>\n    </div>\n  </section>\n\n  <div class=\"fcd-grid\">\n    <section class=\"fcd-card\" id=\"by-province\">\n      <div class=\"fcd-card-head\">\n        <h2>เนื้อที่แต่ละระดับ รายจังหวัด</h2>\n        <p class=\"fcd-sub\">เรียงจากจังหวัดที่มีเนื้อที่ FCD มากที่สุด ตัวเลขท้ายแท่งคือเนื้อที่รวม (ไร่) ชี้ที่แท่งเพื่อดูรายละเอียด กดที่จังหวัดเพื่อดูเฉพาะจังหวัดนั้น</p>\n        <div class=\"fcd-legend\"><span><i class=\"sw sw-high\"></i>มาก</span><span><i class=\"sw sw-mid\"></i>ปานกลาง</span><span><i class=\"sw sw-low\"></i>น้อย</span><span><i class=\"sw sw-none\"></i>ไม่ระบุระดับ</span></div>\n      </div>\n      <div class=\"fcd-chart\" data-draw=\"prov\" data-source=\"fcd\">—</div>\n    </section>\n\n    <section class=\"fcd-card\" id=\"ranking\">\n      <div class=\"fcd-card-head\">\n        <h2>แปลงที่มีระดับมากที่สุดและน้อยที่สุด</h2>\n        <p class=\"fcd-sub\">5 อันดับในขอบเขตที่เลือก</p>\n      </div>\n      <div class=\"fcd-card-head\">\n        <div class=\"fcd-tile-k\"><i class=\"sw sw-high\"></i>เนื้อที่ระดับมากสูงสุด (ไร่)</div>\n        <ol class=\"fcd-rank\" data-draw=\"rank\" data-kind=\"high\" data-source=\"fcd\"></ol>\n      </div>\n      <div class=\"fcd-card-head\">\n        <div class=\"fcd-tile-k\"><i class=\"sw sw-low\"></i>เนื้อที่ระดับน้อยและไม่ระบุสูงสุด (ไร่)</div>\n        <ol class=\"fcd-rank\" data-draw=\"rank\" data-kind=\"low\" data-source=\"fcd\"></ol>\n      </div>\n      <div class=\"fcd-card-head\">\n        <div class=\"fcd-tile-k\"><i class=\"sw sw-high\"></i>สัดส่วนระดับมากสูงสุด (แปลงตั้งแต่ 10 ไร่)</div>\n        <ol class=\"fcd-rank\" data-draw=\"rank\" data-kind=\"highpct\" data-source=\"fcd\"></ol>\n      </div>\n    </section>\n\n    <section class=\"fcd-card\" id=\"baseline\">\n      <div class=\"fcd-card-head\">\n        <h2>แปลง baseline ตามระดับ FCD</h2>\n        <p class=\"fcd-sub\">จำนวนแปลง baseline ที่ตกอยู่ในแต่ละระดับ ในขอบเขตที่เลือก</p>\n      </div>\n      <p class=\"fcd-take\" data-draw=\"blHead\" data-source=\"baseline fcd\">—</p>\n      <div class=\"fcd-chart\" data-draw=\"blSum\" data-source=\"baseline fcd\">—</div>\n    </section>\n  </div>\n\n  <div class=\"fcd-pair\">\n  <section class=\"fcd-card\" id=\"by-plot\">\n    <div class=\"fcd-card-head\">\n      <h2>เนื้อที่แต่ละระดับ รายแปลง</h2>\n      <p class=\"fcd-sub\">ดูเป็นไร่เพื่อเทียบขนาดแปลง หรือร้อยละเพื่อเทียบสัดส่วนระดับในแต่ละแปลง กดที่แท่งเพื่อเปิดแผนที่แปลงนั้น</p>\n    </div>\n    <div class=\"fcd-tools\">\n      <div class=\"fcd-seg\" role=\"group\" aria-label=\"หน่วย\">\n        <button type=\"button\" data-mode=\"rai\" aria-pressed=\"true\">ไร่</button>\n        <button type=\"button\" data-mode=\"pct\" aria-pressed=\"false\">ร้อยละ</button>\n      </div>\n      <div class=\"fcd-seg\" role=\"group\" aria-label=\"เรียงตาม\">\n        <button type=\"button\" data-sort=\"total\" aria-pressed=\"true\">เนื้อที่รวม</button>\n        <button type=\"button\" data-sort=\"high_pct\" aria-pressed=\"false\">สัดส่วนมาก</button>\n        <button type=\"button\" data-sort=\"low_pct\" aria-pressed=\"false\">สัดส่วนน้อย+ไม่ระบุ</button>\n        <button type=\"button\" data-sort=\"plot\" aria-pressed=\"false\">รหัสแปลง</button>\n      </div>\n      <div class=\"fcd-legend\"><span><i class=\"sw sw-high\"></i>มาก</span><span><i class=\"sw sw-mid\"></i>ปานกลาง</span><span><i class=\"sw sw-low\"></i>น้อย</span><span><i class=\"sw sw-none\"></i>ไม่ระบุระดับ</span></div>\n    </div>\n    <div class=\"fcd-scroll\"><div class=\"fcd-chart\" data-draw=\"plots\" data-source=\"fcd\">—</div></div>\n  </section>\n\n  <section class=\"fcd-card\" id=\"map\">\n    <div class=\"fcd-card-head\">\n      <h2>แผนที่ FCD</h2>\n      <p class=\"fcd-sub\">แปลงที่มีแปลง baseline ใช้แผนที่ชุด FCD + แปลง baseline (กรอบฟ้า BL-n) แปลงอื่นใช้แผนที่ FCD เดิม ลายเส้นเขียว เหลือง แดง คือระดับมาก ปานกลาง น้อย เส้นแดงทึบคือขอบเขตพื้นที่โครงการ เลือกแปลงจากรายการ หรือกดที่แท่งหรือแถวในตาราง</p>\n    </div>\n    <div class=\"fcd-tools\">\n      <label class=\"fcd-sub\" for=\"fcd-pick\">แปลง</label>\n      <select id=\"fcd-pick\" class=\"dash-select fcd-pick\" data-draw=\"mapPick\" data-source=\"fcd\" aria-label=\"เลือกแปลงที่จะดูแผนที่\"></select>\n    </div>\n    <p class=\"fcd-mapinfo\" data-draw=\"mapInfo\" data-source=\"fcd\">—</p>\n    <div class=\"fcd-map\" data-draw=\"map\" data-source=\"fcd\">—</div>\n    <div class=\"fcd-card-head\" id=\"map-baseline\">\n      <div class=\"fcd-tile-k\">แปลง baseline ในแปลงนี้</div>\n      <p class=\"fcd-sub\" data-draw=\"blNote\" data-source=\"baseline\">—</p>\n      <div class=\"fcd-tbox\">\n        <table data-source=\"baseline\" data-row-key=\"id\">\n          <thead><tr>\n            <th data-field=\"baseline\"><span class=\"th-t\">แปลง</span></th>\n            <th data-field=\"fcd_level\"><span class=\"th-t\">ระดับ FCD</span></th>\n            <th data-field=\"rai\" class=\"n\"><span class=\"th-t\">เนื้อที่ (ไร่)</span></th>\n            <th data-field=\"E\" class=\"n\"><span class=\"th-t\">E</span></th>\n            <th data-field=\"N\" class=\"n\"><span class=\"th-t\">N</span></th>\n          </tr></thead>\n          <tbody data-draw=\"blTable\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n  </div>\n\n  <section class=\"fcd-card\" id=\"table\">\n    <div class=\"fcd-card-head\">\n      <h2>ตารางรายแปลง</h2>\n      <p class=\"fcd-sub\">กดหัวคอลัมน์เพื่อเรียง ดาวน์โหลดเป็น CSV ได้จากเมนู Sources</p>\n    </div>\n    <div class=\"fcd-tools\">\n      <input id=\"fcd-q\" class=\"fcd-search\" type=\"search\" placeholder=\"ค้นหารหัสแปลง จังหวัด หรือเล่ม\" aria-label=\"ค้นหาในตาราง\">\n      <span class=\"fcd-sub\">แสดง <b data-draw=\"tcount\">—</b> แปลง</span>\n    </div>\n    <div class=\"fcd-tbox\">\n      <table data-source=\"fcd\" data-row-key=\"plot\">\n        <thead><tr>\n          <th data-field=\"plot\" data-k=\"plot\"><button type=\"button\">แปลง</button></th>\n          <th data-field=\"province\" data-k=\"province\"><button type=\"button\">จังหวัด</button></th>\n          <th data-field=\"ptype\" data-k=\"ptype\" class=\"hide-sm\"><button type=\"button\">ประเภท</button></th>\n          <th data-field=\"book\" data-k=\"book\" class=\"hide-sm\"><button type=\"button\">เล่ม PDD</button></th>\n          <th data-field=\"high\" data-k=\"high\" class=\"n\"><button type=\"button\">มาก</button></th>\n          <th data-field=\"mid\" data-k=\"mid\" class=\"n\"><button type=\"button\">ปานกลาง</button></th>\n          <th data-field=\"low\" data-k=\"low\" class=\"n\"><button type=\"button\">น้อย</button></th>\n          <th data-field=\"none\" data-k=\"none\" class=\"n\"><button type=\"button\">ไม่ระบุ</button></th>\n          <th data-field=\"total\" data-k=\"total\" class=\"n\" aria-sort=\"descending\"><button type=\"button\">รวม (ไร่)</button></th>\n          <th data-field=\"water\" data-k=\"water\" class=\"n hide-sm\"><button type=\"button\">แหล่งน้ำ</button></th>\n          <th data-field=\"baseline_n\" data-k=\"baseline_n\" class=\"n\"><button type=\"button\">baseline</button></th>\n          <th data-field=\"note\" data-k=\"note\" class=\"hide-sm\"><button type=\"button\">หมายเหตุ</button></th>\n        </tr></thead>\n        <tbody data-draw=\"table\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <details>\n    <summary>ที่มาของตัวเลขและข้อควรรู้</summary>\n    <dl>\n      <dt>ที่มา</dt><dd>ไฟล์ fcd_area.csv จากสคริปต์ทำแผนที่ FCD (make_fcd_maps.py) จับคู่เล่ม PDD จากทะเบียนรายแปลง SiamTC_Plot_to_PDD_7Books_160Plots</dd>\n      <dt>ระดับ</dt><dd>ร้อยละการปกคลุมเรือนยอดจาก Landsat 8: มาก มากกว่า 65% ปานกลาง 30–65% น้อย ต่ำกว่า 30% ส่วน \"ไม่ระบุระดับ\" คือ gridcode 0 (Bare/FCD-Process Error)</dd>\n      <dt>เนื้อที่รวม</dt><dd>ผลรวมของ 4 ระดับ ไม่รวมแหล่งน้ำ จึงอาจต่างจากเนื้อที่ตามตารางคุมบนหัวแผนที่เล็กน้อย</dd>\n      <dt>ขอบเขต</dt><dd>STC ตัด FCD ตามขอบเขต MOC_2_ใช้งาน ส่วน VSD ใช้ไฟล์ FCD รายแปลง แปลงที่ไม่มีไฟล์ขอบเขต \"ใช้งาน\" ใช้ขอบเขต MOC_2/MOC_1 แทน</dd>\n      <dt>แปลงที่มีหมายเหตุ</dt><dd><ul data-draw=\"notes\" data-source=\"fcd\"></ul></dd>\n    </dl>\n  </details>\n</div>\n\n<script>\n  const F = window.FCD = window.FCD || {};\n  F.state = { scope: 'all', mode: 'rai', sort: 'total', tKey: 'total', tDir: -1, q: '' };\n  F.LV = [['high', 'มาก'], ['mid', 'ปานกลาง'], ['low', 'น้อย'], ['none', 'ไม่ระบุระดับ']];\n  F.n = (v) => +v || 0;\n  F.rai = d3.format(',.2f');\n  F.int = d3.format(',');\n  F.pct = d3.format('.1%');\n  F.plotNum = (p) => { const m = String(p).match(/^(\\d+)(?:\\((\\d+)\\))?/); return m ? (+m[1]) * 100 + (+(m[2] || 0)) : 1e9; };\n  F.inScope = (r) => {\n    const s = F.state.scope;\n    if (s === 'all') return true;\n    const k = s.slice(0, 2), v = s.slice(2);\n    return (k === 'p:' && r.province === v) || (k === 'b:' && r.book === v) || (k === 't:' && r.ptype === v);\n  };\n  F.rows = () => { const d = dash.data('fcd'); return d.status === 'ok' ? d.data.filter(F.inScope) : null; };\n  F.agg = (rs) => {\n    const o = { high: 0, mid: 0, low: 0, none: 0, total: 0 };\n    rs.forEach((r) => { F.LV.forEach(([k]) => { o[k] += F.n(r[k]); }); o.total += F.n(r.total); });\n    return o;\n  };\n  F.redraw = () => {\n    document.querySelectorAll('.fcd-reset').forEach((b) => { b.hidden = F.state.scope === 'all'; });\n    ['sum', 'comp', 'meter', 'scopeName', 'prov', 'plots', 'rank', 'table', 'tcount', 'scope', 'mapPick', 'mapInfo', 'map', 'blNote', 'blTable', 'blHead', 'blSum'].forEach((n) => dash.draw(n));\n  };\n  F.setScope = (s) => { F.state.scope = s || 'all'; F.redraw(); };\n  F.keyPick = (el, fn) => {\n    el.tabIndex = 0;\n    el.addEventListener('click', fn);\n    el.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); fn(); } });\n  };\n  F.state.plot = null;\n  F.curPlot = () => {\n    const rs = F.rows();\n    if (!rs || !rs.length) return null;\n    const hit = rs.find((r) => r.plot === F.state.plot);\n    if (hit) return hit;\n    return rs.slice().sort((a, b) => F.plotNum(a.plot) - F.plotNum(b.plot))[0];\n  };\n  F.pick = (plot) => {\n    F.state.plot = plot;\n    ['mapPick', 'mapInfo', 'map', 'plots', 'table', 'blNote', 'blTable'].forEach((n) => dash.draw(n));\n  };\n\n  dash.calc('summary', {\n    inputs: ['fcd'],\n    title: 'สรุปเนื้อที่ตามขอบเขต',\n    description: 'รวมเนื้อที่แต่ละระดับ (ไร่) และสัดส่วนต่อเนื้อที่รวม ทั้งหมด รายจังหวัด รายเล่ม PDD และรายประเภท',\n    fn: (fcd) => {\n      const n = (v) => +v || 0;\n      const make = (scope, label, group, rs) => {\n        const s = (k) => +rs.reduce((a, r) => a + n(r[k]), 0).toFixed(2);\n        const t = s('total');\n        const p = (k) => (t ? +(s(k) / t).toFixed(4) : 0);\n        return { scope, label, group, plots: rs.length, high: s('high'), mid: s('mid'), low: s('low'), none: s('none'), total: t, water: s('water'),\n          high_pct: p('high'), mid_pct: p('mid'), low_pct: p('low'), none_pct: p('none') };\n      };\n      const by = (key, prefix, group) => {\n        const m = new Map();\n        fcd.forEach((r) => { if (!m.has(r[key])) m.set(r[key], []); m.get(r[key]).push(r); });\n        return [...m].map(([v, rs]) => make(prefix + v, v, group, rs)).sort((a, b) => b.total - a.total);\n      };\n      return [make('all', 'ทุกแปลง', 'ทั้งหมด', fcd), ...by('province', 'p:', 'จังหวัด'), ...by('book', 'b:', 'เล่ม PDD'), ...by('ptype', 't:', 'ประเภทแปลง')];\n    }\n  });\n\n  dash.draw('scope', (sel) => {\n    const d = dash.data('summary');\n    const rows = d.status === 'ok' ? d.data : [];\n    const groups = new Map();\n    rows.forEach((r) => { if (!groups.has(r.group)) groups.set(r.group, []); groups.get(r.group).push(r); });\n    sel.replaceChildren(...[...groups].map(([g, rs]) => {\n      if (g === 'ทั้งหมด') return new Option(`ทุกแปลง (${rs[0].plots} แปลง)`, 'all');\n      const og = document.createElement('optgroup');\n      og.label = g;\n      rs.forEach((r) => og.append(new Option(`${r.label} (${r.plots} แปลง)`, r.scope)));\n      return og;\n    }));\n    if (!rows.length) sel.append(new Option('ทุกแปลง', 'all'));\n    sel.value = F.state.scope;\n    sel.onchange = () => F.setScope(sel.value);\n  });\n\n  dash.draw('scopeName', (el) => {\n    const d = dash.data('summary');\n    const r = d.status === 'ok' ? d.data.find((x) => x.scope === F.state.scope) : null;\n    if (!r) { el.textContent = '—'; return; }\n    el.textContent = r.scope === 'all' ? 'ทุกแปลง' : (r.group === 'จังหวัด' ? `จังหวัด${r.label}` : r.group === 'ประเภทแปลง' ? `แปลง ${r.label}` : `เล่ม ${r.label}`);\n  });\n\n  dash.draw('sum', (el) => {\n    el.setAttribute('data-where', 'scope=' + encodeURIComponent(F.state.scope));\n    const d = dash.data('summary');\n    const r = d.status === 'ok' ? d.data.find((x) => x.scope === F.state.scope) : null;\n    el.classList.toggle('dash-skeleton', d.status === 'loading');\n    if (!r) { el.textContent = '—'; return; }\n    const v = r[el.dataset.field], f = el.dataset.fmt;\n    el.textContent = f === 'pct' ? F.pct(v) : f === 'int' ? F.int(v) : F.rai(v);\n  });\n\n  F.curSummary = () => {\n    const d = dash.data('summary');\n    return d.status === 'ok' ? d.data.find((x) => x.scope === F.state.scope) : null;\n  };\n\n  dash.draw('comp', (el) => {\n    const r = F.curSummary();\n    el.classList.toggle('dash-skeleton', dash.data('summary').status === 'loading');\n    if (!r) { el.textContent = '—'; return; }\n    const segs = F.LV.filter(([k]) => r[k + '_pct'] > 0).map(([k, name]) => {\n      const s = document.createElement('i');\n      s.className = 'seg-' + k;\n      s.style.flex = `${r[k + '_pct']} 1 0`;\n      s.title = `${name} ${F.rai(r[k])} ไร่ (${F.pct(r[k + '_pct'])})`;\n      if (r[k + '_pct'] >= 0.06) s.textContent = `${name} ${F.pct(r[k + '_pct'])}`;\n      return s;\n    });\n    el.replaceChildren(...segs);\n    el.setAttribute('aria-label', 'สัดส่วนเนื้อที่: ' + F.LV.map(([k, name]) => `${name} ${F.pct(r[k + '_pct'])}`).join(', '));\n  });\n\n  dash.draw('meter', (el) => {\n    const r = F.curSummary();\n    el.style.width = r ? (r[el.dataset.k] * 100) + '%' : '0';\n  });\n\n  F.tip = (box) => {\n    let t = box.querySelector(':scope > .fcd-tip');\n    if (!t) { t = document.createElement('div'); t.className = 'fcd-tip'; t.hidden = true; box.append(t); }\n    return t;\n  };\n  F.showTip = (box, row, ev, title, o) => {\n    const t = F.tip(box);\n    const tt = document.createElement('div'); tt.className = 'tt'; tt.textContent = title;\n    const lines = F.LV.map(([k, name]) => {\n      const l = document.createElement('div'); l.className = 'tl';\n      const sw = document.createElement('i'); sw.className = 'sw sw-' + k;\n      const nm = document.createElement('span'); nm.textContent = name;\n      const v = document.createElement('em'); v.textContent = `${F.rai(o[k])} ไร่ · ${F.pct(o.total ? o[k] / o.total : 0)}`;\n      l.append(sw, nm, v); return l;\n    });\n    const tot = document.createElement('div'); tot.className = 'tl';\n    const tn = document.createElement('b'); tn.textContent = 'รวม';\n    const tv = document.createElement('em'); tv.textContent = `${F.rai(o.total)} ไร่`;\n    tot.append(tn, tv);\n    t.replaceChildren(tt, ...lines, tot);\n    t.hidden = false;\n    const br = box.getBoundingClientRect(), rr = row.getBoundingClientRect();\n    const w = t.offsetWidth, h = t.offsetHeight;\n    let x = ev.clientX - br.left + 12; if (x + w > box.clientWidth) x = Math.max(0, ev.clientX - br.left - w - 12);\n    let y = rr.bottom - br.top + 4; if (y + h > box.scrollHeight && rr.top - br.top - h - 4 > 0) y = rr.top - br.top - h - 4;\n    t.style.left = x + 'px'; t.style.top = y + 'px';\n  };\n  F.bars = (el, items, mode, onPick) => {\n    const max = d3.max(items, (d) => d.total) || 1;\n    const rows = items.map((d) => {\n      const row = document.createElement('div'); row.className = 'hrow';\n      const lb = document.createElement('div'); lb.className = 'lb'; lb.textContent = d.label;\n      const tr = document.createElement('div'); tr.className = 'tr';\n      const base = mode === 'pct' ? (d.total || 1) : max;\n      F.LV.forEach(([k]) => { if (d[k] > 0) { const s = document.createElement('i'); s.className = 'seg-' + k; s.style.width = (d[k] / base * 100) + '%'; tr.append(s); } });\n      const vl = document.createElement('div'); vl.className = 'vl';\n      vl.textContent = mode === 'pct' ? F.pct(d.total ? d.high / d.total : 0) + ' มาก' : F.rai(d.total);\n      row.append(lb, tr, vl);\n      if (onPick) {\n        row.setAttribute('role', 'button');\n        row.setAttribute('aria-label', `${d.title || d.label} เนื้อที่รวม ${F.rai(d.total)} ไร่ มาก ${F.pct(d.total ? d.high / d.total : 0)}`);\n        if (d.plot) { const cur = F.curPlot(); if (cur && cur.plot === d.plot) { row.classList.add('on'); row.setAttribute('aria-pressed', 'true'); } }\n        F.keyPick(row, () => onPick(d));\n        row.addEventListener('focus', () => { const rr = row.getBoundingClientRect(); F.showTip(el, row, { clientX: rr.left + rr.width / 2 }, d.title || d.label, d); });\n        row.addEventListener('blur', () => { F.tip(el).hidden = true; });\n      }\n      row.addEventListener('mousemove', (ev) => F.showTip(el, row, ev, d.title || d.label, d));\n      row.addEventListener('mouseleave', () => { F.tip(el).hidden = true; });\n      return row;\n    });\n    el.replaceChildren(...rows);\n    F.tip(el);\n  };\n\n  dash.draw('prov', (el) => {\n    const rs = F.rows();\n    el.classList.toggle('dash-skeleton', dash.data('fcd').status === 'loading');\n    if (!rs) { el.textContent = '—'; return; }\n    const m = d3.group(rs, (r) => r.province);\n    const items = [...m].map(([p, g]) => Object.assign(F.agg(g), { label: p, title: `${p} · ${g.length} แปลง` })).sort((a, b) => b.total - a.total);\n    F.bars(el, items, 'rai', F.state.scope.startsWith('p:') ? null : (d) => F.setScope('p:' + d.label));\n  });\n\n  dash.draw('plots', (el) => {\n    const rs = F.rows();\n    el.classList.toggle('dash-skeleton', dash.data('fcd').status === 'loading');\n    if (!rs) { el.textContent = '—'; return; }\n    const items = rs.map((r) => Object.assign(F.agg([r]), { label: r.plot, plot: r.plot, title: `${r.plot} · ${r.province} · ${r.book}` }));\n    const s = F.state.sort;\n    const share = (d, ks) => (d.total ? ks.reduce((a, k) => a + d[k], 0) / d.total : 0);\n    items.sort(s === 'plot' ? (a, b) => F.plotNum(a.plot) - F.plotNum(b.plot) || a.plot.localeCompare(b.plot)\n      : s === 'high_pct' ? (a, b) => share(b, ['high']) - share(a, ['high'])\n      : s === 'low_pct' ? (a, b) => share(b, ['low', 'none']) - share(a, ['low', 'none'])\n      : (a, b) => b.total - a.total);\n    F.bars(el, items, F.state.mode, (d) => F.pick(d.plot));\n  });\n\n  dash.draw('rank', (el) => {\n    const rs = F.rows();\n    if (!rs) { el.replaceChildren(); return; }\n    const kind = el.dataset.kind;\n    const v = (r) => kind === 'high' ? F.n(r.high) : kind === 'low' ? F.n(r.low) + F.n(r.none) : (F.n(r.total) ? F.n(r.high) / F.n(r.total) : 0);\n    const pool = kind === 'highpct' ? rs.filter((r) => F.n(r.total) >= 10) : rs;\n    const top = pool.slice().sort((a, b) => v(b) - v(a)).slice(0, 5).filter((r) => v(r) > 0);\n    el.replaceChildren(...top.map((r) => {\n      const li = document.createElement('li');\n      const b = document.createElement('b'); b.textContent = r.plot;\n      const sp = document.createElement('span');\n      sp.textContent = ` ${r.province} · ` + (kind === 'highpct' ? `${F.pct(v(r))} ของ ${F.rai(F.n(r.total))} ไร่` : `${F.rai(v(r))} ไร่ (${F.pct(F.n(r.total) ? v(r) / F.n(r.total) : 0)} ของแปลง)`);\n      li.append(b, sp); return li;\n    }));\n    if (!top.length) { const li = document.createElement('li'); li.textContent = 'ไม่มีแปลงในขอบเขตนี้'; el.append(li); }\n  });\n\n  F.tableRows = () => {\n    const rs = F.rows();\n    if (!rs) return null;\n    const q = F.state.q.trim().toLowerCase();\n    const k = F.state.tKey, dir = F.state.tDir;\n    const numK = ['high', 'mid', 'low', 'none', 'total', 'water', 'baseline_n'].includes(k);\n    return rs.filter((r) => !q || [r.plot, r.province, r.book, r.ptype, r.note].join(' ').toLowerCase().includes(q))\n      .sort((a, b) => numK ? dir * (F.n(a[k]) - F.n(b[k])) : k === 'plot' ? dir * (F.plotNum(a.plot) - F.plotNum(b.plot)) : dir * String(a[k]).localeCompare(String(b[k]), 'th'));\n  };\n\n  dash.draw('table', (tb) => {\n    const rs = F.tableRows();\n    if (!rs) { tb.replaceChildren(); return; }\n    const cols = ['plot', 'province', 'ptype', 'book', 'high', 'mid', 'low', 'none', 'total', 'water', 'baseline_n', 'note'];\n    const numK = ['high', 'mid', 'low', 'none', 'total', 'water'];\n    const hide = ['ptype', 'book', 'water', 'note'];\n    const cur = F.curPlot();\n    tb.replaceChildren(...rs.map((r) => {\n      const tr = document.createElement('tr');\n      if (cur && cur.plot === r.plot) tr.classList.add('on');\n      F.keyPick(tr, () => {\n        F.pick(r.plot);\n        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;\n        document.querySelectorAll('#map').forEach((m) => m.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'nearest' }));\n      });\n      cols.forEach((c) => {\n        const td = document.createElement('td');\n        td.textContent = numK.includes(c) ? F.rai(F.n(r[c])) : (r[c] || '');\n        if (c === 'baseline_n') { td.textContent = r[c] || '0'; td.classList.add('n'); }\n        if (numK.includes(c)) td.classList.add('n');\n        if (c === 'note') td.classList.add('wrap');\n        if (hide.includes(c)) td.classList.add('hide-sm');\n        tr.append(td);\n      });\n      return tr;\n    }));\n  });\n\n  dash.draw('tcount', (el) => {\n    const rs = F.tableRows();\n    el.textContent = rs ? F.int(rs.length) : '—';\n  });\n\n  dash.draw('mapPick', (sel) => {\n    const rs = F.rows();\n    if (!rs) { sel.replaceChildren(); return; }\n    const sorted = rs.slice().sort((a, b) => F.plotNum(a.plot) - F.plotNum(b.plot) || a.plot.localeCompare(b.plot));\n    sel.replaceChildren(...sorted.map((r) => new Option(`${r.plot} · ${r.province}`, r.plot)));\n    const cur = F.curPlot();\n    sel.value = cur ? cur.plot : '';\n    sel.onchange = () => F.pick(sel.value);\n  });\n\n  dash.draw('mapInfo', (el) => {\n    const r = F.curPlot();\n    if (!r) { el.textContent = '—'; return; }\n    el.textContent = `${r.plot} · จังหวัด${r.province} · ${r.book} · รวม ${F.rai(F.n(r.total))} ไร่ (มาก ${F.rai(F.n(r.high))} · ปานกลาง ${F.rai(F.n(r.mid))} · น้อย ${F.rai(F.n(r.low))} · ไม่ระบุ ${F.rai(F.n(r.none))})`;\n  });\n\n  dash.draw('map', (el) => {\n    const r = F.curPlot();\n    el.classList.toggle('dash-skeleton', dash.data('fcd').status === 'loading');\n    if (!r) { el.textContent = '—'; return; }\n    if (!r.map) { el.textContent = 'ยังไม่มีรูปแผนที่ของแปลงนี้'; return; }\n    let img = el.querySelector('img'), a = el.querySelector('a');\n    if (!img) {\n      img = document.createElement('img');\n      img.decoding = 'async';\n      img.addEventListener('load', () => img.classList.remove('loading'));\n      img.addEventListener('error', () => img.classList.remove('loading'));\n      a = document.createElement('a');\n      a.target = '_blank'; a.rel = 'noopener';\n      a.textContent = 'เปิดรูปแผนที่ขนาดเต็มในแท็บใหม่';\n      el.replaceChildren(img, a);\n    }\n    if (img.getAttribute('src') !== r.map) { img.classList.add('loading'); img.setAttribute('src', r.map); }\n    img.alt = `แผนที่การปกคลุมเรือนยอด (FCD) แปลง ${r.plot} จังหวัด${r.province}`;\n    a.href = r.map;\n  });\n\n  F.blFor = (plot) => {\n    const b = dash.data('baseline');\n    if (b.status !== 'ok') return null;\n    return b.data.filter((x) => x.plot === plot).sort((a, c) => (parseInt(a.baseline.replace(/\\D/g, ''), 10) || 0) - (parseInt(c.baseline.replace(/\\D/g, ''), 10) || 0));\n  };\n\n  dash.draw('blNote', (el) => {\n    const r = F.curPlot();\n    const bl = r ? F.blFor(r.plot) : null;\n    if (!r || !bl) { el.textContent = '—'; return; }\n    el.textContent = bl.length\n      ? `${r.plot} มีแปลง baseline ${bl.length} แปลง`\n      : `${r.plot} ไม่มีแปลง baseline จึงแสดงแผนที่ FCD เดิม`;\n  });\n\n  dash.draw('blTable', (tb) => {\n    const r = F.curPlot();\n    const bl = r ? F.blFor(r.plot) : null;\n    if (!bl) { tb.replaceChildren(); return; }\n    tb.replaceChildren(...bl.map((b) => {\n      const tr = document.createElement('tr');\n      tr.dataset.key = b.id;\n      [b.baseline, b.fcd_level, F.rai(F.n(b.rai)), b.E, b.N].forEach((v, i) => {\n        const td = document.createElement('td');\n        td.textContent = v;\n        if (i >= 2) td.classList.add('n');\n        tr.append(td);\n      });\n      return tr;\n    }));\n  });\n\n  F.blScope = () => {\n    const rs = F.rows(), b = dash.data('baseline');\n    if (!rs || b.status !== 'ok') return null;\n    const plots = new Set(rs.map((r) => r.plot));\n    return { bl: b.data.filter((x) => plots.has(x.plot)), plots: rs.length, withBl: rs.filter((r) => F.n(r.baseline_n) > 0).length };\n  };\n\n  dash.draw('blHead', (el) => {\n    const s = F.blScope();\n    if (!s) { el.textContent = '—'; return; }\n    el.textContent = s.bl.length\n      ? `แปลง baseline ${F.int(s.bl.length)} แปลง อยู่ใน ${F.int(s.withBl)} จาก ${F.int(s.plots)} แปลงปลูก`\n      : `ไม่มีแปลง baseline ในขอบเขตนี้ (${F.int(s.plots)} แปลงปลูก)`;\n  });\n\n  dash.draw('blSum', (el) => {\n    const s = F.blScope();\n    if (!s) { el.textContent = '—'; return; }\n    const lv = [['high', 'มาก'], ['mid', 'ปานกลาง'], ['low', 'น้อย']];\n    const total = s.bl.length || 1;\n    const max = Math.max(1, ...lv.map(([, name]) => s.bl.filter((x) => x.fcd_level === name).length));\n    el.replaceChildren(...lv.map(([k, name]) => {\n      const n = s.bl.filter((x) => x.fcd_level === name).length;\n      const row = document.createElement('div'); row.className = 'hrow';\n      const lb = document.createElement('div'); lb.className = 'lb'; lb.textContent = name;\n      const tr = document.createElement('div'); tr.className = 'tr';\n      if (n) { const seg = document.createElement('i'); seg.className = 'seg-' + k; seg.style.width = (n / max * 100) + '%'; tr.append(seg); }\n      const vl = document.createElement('div'); vl.className = 'vl';\n      vl.textContent = `${F.int(n)} แปลง · ${F.pct(n / total)}`;\n      row.append(lb, tr, vl);\n      return row;\n    }));\n  });\n\n  dash.draw('notes', (ul) => {\n    const d = dash.data('fcd');\n    if (d.status !== 'ok') { ul.replaceChildren(); return; }\n    const noB = d.data.filter((r) => /ไม่มีไฟล์ขอบเขต/.test(r.note || '')).map((r) => r.plot);\n    const other = d.data.filter((r) => r.note && !/ไม่มีไฟล์ขอบเขต/.test(r.note));\n    const items = [];\n    if (noB.length) { const li = document.createElement('li'); li.textContent = `ไม่มีไฟล์ขอบเขต \"ใช้งาน\" ${noB.length} แปลง: ${noB.join(', ')}`; items.push(li); }\n    other.forEach((r) => { const li = document.createElement('li'); li.textContent = `${r.plot}: ${r.note}`; items.push(li); });\n    ul.replaceChildren(...items);\n  });\n\n  document.querySelectorAll('.fcd-reset').forEach((b) => b.addEventListener('click', () => F.setScope('all')));\n  document.querySelectorAll('.fcd [data-mode]').forEach((b) => b.addEventListener('click', () => {\n    F.state.mode = b.dataset.mode;\n    document.querySelectorAll('.fcd [data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));\n    dash.draw('plots');\n  }));\n  document.querySelectorAll('.fcd [data-sort]').forEach((b) => b.addEventListener('click', () => {\n    F.state.sort = b.dataset.sort;\n    document.querySelectorAll('.fcd [data-sort]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));\n    dash.draw('plots');\n  }));\n  document.querySelectorAll('.fcd th[data-k] button').forEach((b) => b.addEventListener('click', () => {\n    const th = b.closest('th'), k = th.dataset.k;\n    if (F.state.tKey === k) F.state.tDir = -F.state.tDir;\n    else { F.state.tKey = k; F.state.tDir = ['high', 'mid', 'low', 'none', 'total', 'water', 'baseline_n'].includes(k) ? -1 : 1; }\n    document.querySelectorAll('.fcd th[data-k]').forEach((x) => {\n      if (x === th) x.setAttribute('aria-sort', F.state.tDir > 0 ? 'ascending' : 'descending'); else x.removeAttribute('aria-sort');\n    });\n    dash.draw('table');\n  }));\n  document.querySelectorAll('#fcd-q').forEach((inp) => inp.addEventListener('input', () => {\n    F.state.q = inp.value;\n    dash.draw('table'); dash.draw('tcount');\n  }));\n</script>\n", "edit": {"via": "claude", "at": "2026-11-06T02:47:53Z"}}